# dependencies
node_modules/

# build output: the single-file game dist/IITG_Campus_3D.html is kept so the game can be played without building;
# the Claude Artifact variant is regenerated by `npm run build`
dist/artifact.html

# the institute's own documents (printed campus maps, master plan) are not ours to redistribute
*.pdf
tools/plan/*.png

# old screenshots from earlier versions (README pictures live in docs/images)
screenshots/

# notes and conversation logs kept on the author's machine
chat_*.txt

# editor, OS and tool leftovers
.DS_Store
Thumbs.db
.vscode/
.idea/
*.bak
*.log
__pycache__/
*.pyc
tools/qa/.unit-tests.bundle.mjs
.claude/

# unrelated files that landed in this folder (not part of the game)
ev_late_*
